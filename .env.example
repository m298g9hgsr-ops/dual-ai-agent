# --- Provider: openai (default) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Provider: anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Provider: ollama (local, no API key) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Per-agent provider/model override (e.g. architect on anthropic, engineer on openai)
# ARCHITECT_PROVIDER=anthropic
# ENGINEER_PROVIDER=openai
# REVIEWER_PROVIDER=anthropic
# ARCHITECT_MODEL=claude-sonnet-4-20250514
# ENGINEER_MODEL=gpt-4o-mini
# REVIEWER_MODEL=llama3.2

# --- Red/blue adversarial mode (spar) ---
# Which model plays RED (attacker), BLUE (defender) and JUDGE. Leave empty to reuse
# LLM_PROVIDER/OPENAI_MODEL. Pointing RED and BLUE at DIFFERENT models is the point
# of "dual-AI": an independent pair of brains on opposite sides of the wall.
# ATTACKER_PROVIDER=openai
# ATTACKER_MODEL=
# DEFENDER_PROVIDER=anthropic
# DEFENDER_MODEL=
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=

# Hosts the spar agents may touch. Anything else is refused by the executor.
SPAR_ALLOWED_TARGETS=127.0.0.1,localhost

# --- Server ---
# PORT=8000